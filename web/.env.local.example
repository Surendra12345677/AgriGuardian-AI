# Backend URL the Next.js dev server proxies to.
# When running with `docker compose`, the value in docker-compose.yml takes precedence.
BACKEND_URL=http://localhost:8080

# ── Arize observability ────────────────────────────────────────────────────
# These are NEXT_PUBLIC_ so they're baked into the JS bundle at build time.
# Copy the values from your Arize AX dashboard → Settings → Project.
NEXT_PUBLIC_ARIZE_SPACE_ID=
NEXT_PUBLIC_ARIZE_PROJECT_NAME=agriguardian-ai
