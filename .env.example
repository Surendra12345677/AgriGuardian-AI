# ──────────────────────────────────────────────────────────────
# AgriGuardian AI — environment variables template
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored so secrets never reach the repo.
# ──────────────────────────────────────────────────────────────

# ===== Gemini =====
# Get a free API key: https://aistudio.google.com/app/apikey
# Leave blank to use the deterministic stub (app still boots).
GEMINI_API_KEY=
# Hackathon requires Gemini. Keep this on a Gemini-family model.
GEMINI_MODEL=gemini-3-pro-preview
# Optional fallback chain for hosted deploys.
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash
# auto = use stub when key is missing | always = always stub | never = always real
GEMINI_STUB_MODE=auto

# ===== MongoDB =====
MONGODB_URI=mongodb://localhost:27017/agriguardian

# ===== Arize AX + Arize MCP (PRIMARY hackathon partner track) =====
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1
ARIZE_PROJECT_NAME=agriguardian-ai
MCP_ARIZE_ENABLED=false
MCP_ARIZE_URL=
MCP_ARIZE_API_KEY=
MCP_ARIZE_SPACE_ID=

# ===== MongoDB MCP (SECONDARY action tool, not the partner-track qualifier) =====
# Set to true after you start the `mongodb-mcp` sidecar (see docker-compose.yml).
MCP_MONGODB_ENABLED=false
MCP_MONGODB_URL=http://localhost:3100/mcp

# ===== App =====
PORT=8080
SPRING_PROFILES_ACTIVE=dev
